<c:ObservablePage x:Class="LCTWorks.Workshop.Views.Items.SentryPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:c="using:LCTWorks.WinUI.Controls"
                  xmlns:clocal="using:LCTWorks.Workshop.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:LCTWorks.Workshop.Views.Items"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                  mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Orientation="Vertical">
                <clocal:SampleCodePresenter x:Name="Sample"
                                            Margin="16"
                                            HorizontalContentAlignment="Stretch"
                                            Description="A test space for SentryTelemetryServiceInternal. Initialize the SDK with your DSN, then exercise logs, breadcrumbs, handled and unhandled errors, traces (sessions, Issues, Insights) and flush. Every action is echoed to the activity log below."
                                            ExpanderHeader="Code"
                                            Header="Sentry telemetry"
                                            MinOptionsPaneWidth="340"
                                            ShowThemeSwitch="False">
                    <clocal:SampleCodePresenter.Content>
                        <Grid MinWidth="420"
                              MinHeight="360">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <muxc:InfoBar Grid.Row="0"
                                          Margin="0,0,0,12"
                                          IsClosable="False"
                                          IsOpen="True"
                                          Message="{x:Bind StatusMessage, Mode=OneWay}"
                                          Severity="{x:Bind StatusSeverity, Mode=OneWay}"
                                          Title="Service status" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,0,0,8"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="Activity log" />

                            <Border Grid.Row="2"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{x:Bind Activity, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Margin="0,2"
                                                           FontFamily="Consolas"
                                                           IsTextSelectionEnabled="True"
                                                           Text="{x:Bind}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </clocal:SampleCodePresenter.Content>

                    <clocal:SampleCodePresenter.OptionsPaneContent>
                        <StackPanel Width="340"
                                    Orientation="Vertical"
                                    Spacing="8">

                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="Initialization" />
                            <TextBox Header="Sentry DSN"
                                     PlaceholderText="https://key@o0.ingest.sentry.io/0"
                                     Text="{x:Bind Dsn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Environment"
                                     Text="{x:Bind Environment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Initialize service"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Tapped="InitializeTapped" />

                            <MenuFlyoutSeparator />

                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="Logs &amp; breadcrumbs" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Log information"
                                    Tapped="LogInformationTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Log warning (with tags)"
                                    Tapped="LogWarningTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Log navigation"
                                    Tapped="LogNavigationTapped" />

                            <MenuFlyoutSeparator />

                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="Errors (Issues)" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Track handled error"
                                    Tapped="TrackErrorTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Log &amp; track error (extension)"
                                    Tapped="LogAndTrackErrorTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Report unhandled exception (fatal + flush)"
                                    Tapped="ReportUnhandledTapped" />

                            <MenuFlyoutSeparator />

                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="Traces (Performance)" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Start transaction"
                                    Tapped="StartTraceTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Start child span"
                                    Tapped="StartChildTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Append data to transaction"
                                    Tapped="AppendToTraceTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Finish transaction (Ok)"
                                    Tapped="FinishTraceOkTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Finish transaction (error)"
                                    Tapped="FinishTraceErrorTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Disposable trace (success)"
                                    Tapped="DisposableTraceOkTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Disposable trace (throws)"
                                    Tapped="DisposableTraceThrowsTapped" />

                            <MenuFlyoutSeparator />

                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="Scope &amp; lifecycle" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Configure scope tags"
                                    Tapped="ConfigureScopeTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Flush"
                                    Tapped="FlushTapped" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Clear activity log"
                                    Tapped="ClearLogTapped" />
                        </StackPanel>
                    </clocal:SampleCodePresenter.OptionsPaneContent>
                </clocal:SampleCodePresenter>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</c:ObservablePage>
