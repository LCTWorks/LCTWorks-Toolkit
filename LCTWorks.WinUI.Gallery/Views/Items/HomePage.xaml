<Page x:Class="LCTWorks.Workshop.Views.Items.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:LCTWorks.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:LCTWorks.Workshop.Views.Items"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:LCTWorks.Workshop.Models"
      mc:Ignorable="d">

    <Page.Resources>
        <!--  A navigation card  -->
        <DataTemplate x:Key="DocItemCardTemplate"
                      x:DataType="models:DocItem">
            <Button Padding="16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{x:Bind Title}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Click="DocItemClick"
                    CornerRadius="8"
                    Tag="{x:Bind NavigationKey}"
                    ToolTipService.ToolTip="{x:Bind Description}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <c:AdaptiveImage Width="40"
                                     Height="40"
                                     VerticalAlignment="Center"
                                     EnableSvgColorOverride="False"
                                     Source="{x:Bind IconPath}" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Text="{x:Bind Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxLines="2"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Bind Description}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!--  A section: header + card grid  -->
        <DataTemplate x:Key="DocGroupTemplate"
                      x:DataType="models:DocGroup">
            <StackPanel Orientation="Vertical"
                        Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{x:Bind Title}" />
                <ItemsRepeater ItemTemplate="{StaticResource DocItemCardTemplate}"
                               ItemsSource="{x:Bind Items}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill"
                                           MinColumnSpacing="12"
                                           MinItemHeight="88"
                                           MinItemWidth="300"
                                           MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel MaxWidth="1200"
                        Padding="36,24,36,36"
                        Orientation="Vertical"
                        Spacing="32">
                <!--  Hero  -->
                <StackPanel Orientation="Vertical"
                            Spacing="4">
                    <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}"
                               Text="{x:Bind AppDisplayName}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Text="{x:Bind Description}" />
                </StackPanel>

                <ItemsRepeater ItemTemplate="{StaticResource DocGroupTemplate}"
                               ItemsSource="{x:Bind Groups}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="32" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>