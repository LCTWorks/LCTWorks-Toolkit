<c:ObservablePage x:Class="LCTWorks.Workshop.Views.Items.TextResourcesPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:c="using:LCTWorks.WinUI.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:LCTWorks.Workshop.Views.Items"
                  xmlns:m="using:LCTWorks.Workshop.Models"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d">
    <c:ObservablePage.Resources>
        <Style x:Key="CodeStyleTextBlock"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Cascadia Code" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="IsTextSelectionEnabled"
                    Value="True" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>
        <Style x:Key="NotesTextBlock"
               BasedOn="{StaticResource SmoothCaptionTextBlockStyle}"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="IsTextSelectionEnabled"
                    Value="True" />
            <Setter Property="Opacity"
                    Value="0.8" />
        </Style>
        <Style x:Key="SectionTitleTextBlock"
               BasedOn="{StaticResource SmoothTitleTextBlockStyle}"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>
        <Style x:Key="RowSeparator"
               TargetType="MenuFlyoutSeparator">
            <Setter Property="Margin"
                    Value="0,-16" />
            <Setter Property="VerticalAlignment"
                    Value="Top" />
        </Style>
    </c:ObservablePage.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel Margin="24,16,24,32"
                        Orientation="Vertical"
                        Spacing="32">

                <!--  Page header  -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SmoothHeaderTextBlockStyle}"
                               Text="{x:Bind Header}" />
                    <TextBlock Style="{StaticResource SmoothBodyTextBlockStyle}"
                               Text="{x:Bind Description}" />
                </StackPanel>

                <!--  TextBlock styles  -->
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextBlock}"
                               Text="TextBlock styles" />
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource SmoothCaptionTextBlockStyle}"
                               Text="Styles defined in Themes/TextBlocks.xaml. The BasedOn column shows the style each one inherits from." />

                    <Grid ColumnSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                                   Text="Resource name" />
                        <TextBlock Grid.Column="1"
                                   Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                                   Text="Sample" />
                        <TextBlock Grid.Column="2"
                                   Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                                   Text="BasedOn" />

                        <ItemsRepeater Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       ItemsSource="{x:Bind TextBlockStyles, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="m:TextBlockStyleEntry">
                                    <Grid Padding="0,16"
                                          ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <MenuFlyoutSeparator Grid.ColumnSpan="3"
                                                             Style="{StaticResource RowSeparator}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CodeStyleTextBlock}"
                                                       Text="{x:Bind ResourceName}" />
                                            <c:ThemedButton Grid.Column="1"
                                                            Glyph="&#xE8C8;"
                                                            Tag="{x:Bind ResourceName}"
                                                            Tapped="CopyTapped"
                                                            ToolTipService.ToolTip="Copy resource name"
                                                            Visibility="{x:Bind IsValid}" />
                                        </Grid>
                                        <Grid Grid.Column="1"
                                              VerticalAlignment="Center">
                                            <TextBlock MaxLines="1"
                                                       Style="{x:Bind Style}"
                                                       Text="{x:Bind SampleText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource CodeStyleTextBlock}"
                                                   Text="{x:Bind BasedOnDisplay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </StackPanel>
                <!--  Font families  -->
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextBlock}"
                               Text="Font families" />
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource SmoothCaptionTextBlockStyle}"
                               Text="Resources defined in Themes/FontFamilies.xaml. Entries declared as StaticResource aliases list the key they resolve to in the Notes column." />

                    <Grid ColumnSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                                   Text="Resource name" />
                        <TextBlock Grid.Column="1"
                                   Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                                   Text="Sample" />
                        <TextBlock Grid.Column="2"
                                   Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                                   Text="Notes" />

                        <ItemsRepeater Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       ItemsSource="{x:Bind FontFamilies, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="m:FontFamilyEntry">
                                    <Grid Padding="0,16"
                                          ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <MenuFlyoutSeparator Grid.ColumnSpan="3"
                                                             Style="{StaticResource RowSeparator}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CodeStyleTextBlock}"
                                                       Text="{x:Bind ResourceName}" />
                                            <c:ThemedButton Grid.Column="1"
                                                            Glyph="&#xE8C8;"
                                                            Tag="{x:Bind ResourceName}"
                                                            Tapped="CopyTapped"
                                                            ToolTipService.ToolTip="Copy resource name"
                                                            Visibility="{x:Bind IsValid}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{x:Bind SampleFontFamily}"
                                                   FontSize="20"
                                                   IsTextSelectionEnabled="True"
                                                   MaxLines="1"
                                                   Text="{x:Bind SampleText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource NotesTextBlock}"
                                                   Text="{x:Bind Notes}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="InfoBar"
                 Margin="24"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                 IsOpen="False"
                 Severity="Informational" />
    </Grid>
</c:ObservablePage>