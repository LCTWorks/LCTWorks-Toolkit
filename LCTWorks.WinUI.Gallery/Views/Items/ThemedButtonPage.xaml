<c:ObservablePage x:Class="LCTWorks.Workshop.Views.Items.ThemedButtonPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:c="using:LCTWorks.WinUI.Controls"
                  xmlns:clocal="using:LCTWorks.Workshop.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:LCTWorks.Workshop.Views.Items"
                  xmlns:m="using:LCTWorks.Workshop.Models"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                  xmlns:xaml="using:LCTWorks.WinUI.Xaml.Extensions"
                  mc:Ignorable="d">
    <c:ObservablePage.Resources>
        <Style x:Key="CodeStyleTextBlock"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Cascadia Code" />
        </Style>
    </c:ObservablePage.Resources>
    <Grid RequestedTheme="{Binding RequestedTheme, ElementName=Sample1Control, Mode=OneWay}">
        <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Orientation="Vertical"
                        Spacing="24">
                <clocal:SampleCodePresenter x:Name="Sample1Control"
                                            Margin="16"
                                            HorizontalContentAlignment="Stretch"
                                            Description="{x:Bind Description}"
                                            ExpanderHeader="Documentation and code snippets"
                                            Header="{x:Bind Header}"
                                            MarkdownFilePath="ms-appx:///Assets/CodeSnippets/ThemedButton_Md.txt"
                                            MarkdownTabHeader="Documentation"
                                            MinOptionsPaneWidth="320">
                    <clocal:SampleCodePresenter.Content>
                        <Grid>
                            <c:ThemedButton x:Name="SampleButton"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{x:Bind ButtonContent, Mode=OneWay}"
                                            Glyph="{x:Bind Glyph, Mode=OneWay}"
                                            GlyphFontSize="{x:Bind GlyphFontSize, Mode=OneWay}"
                                            ShowGlyph="{x:Bind ShowGlyph, Mode=OneWay}" />
                        </Grid>
                    </clocal:SampleCodePresenter.Content>
                    <clocal:SampleCodePresenter.OptionsPaneContent>
                        <Grid>
                            <StackPanel Orientation="Vertical"
                                        Spacing="8">
                                <TextBox Header="Content"
                                         Text="{x:Bind ButtonContent, Mode=TwoWay}" />
                                <MenuFlyoutSeparator />
                                <ToggleSwitch IsOn="{x:Bind ShowGlyph, Mode=TwoWay}"
                                              OffContent="Show glyph"
                                              OnContent="Show glyph" />
                                <AutoSuggestBox x:Name="GlyphFontFamilySelector"
                                                Header="Glyph Font Family"
                                                IsEnabled="{x:Bind ShowGlyph, Mode=OneWay}"
                                                Text="{x:Bind GlyphFontFamily, Mode=TwoWay}" />
                                <TextBlock x:Name="FontFamilyWarningTextBlock"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Text="We couldn't resolve the provided Font Family."
                                           Visibility="Collapsed" />
                                <TextBox Header="Glyph"
                                         IsEnabled="{x:Bind ShowGlyph, Mode=OneWay}"
                                         Text="{x:Bind Glyph, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </clocal:SampleCodePresenter.OptionsPaneContent>
                </clocal:SampleCodePresenter>
                <Grid Margin="24,0"
                      ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                               Text="Resource name" />
                    <TextBlock Grid.Column="1"
                               Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                               Text="Normal state" />
                    <TextBlock Grid.Column="2"
                               Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                               Text="Pointer over" />
                    <TextBlock Grid.Column="3"
                               Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                               Text="Pressed" />
                    <TextBlock Grid.Column="4"
                               Style="{ThemeResource SmoothItemTitleTextBlockStyle}"
                               Text="Disabled" />

                    <ItemsRepeater Grid.Row="1"
                                   Grid.ColumnSpan="6"
                                   ItemsSource="{x:Bind Styles, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="m:ThemedButtonStyleEntry">
                                <Grid Padding="0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <MenuFlyoutSeparator Grid.ColumnSpan="6"
                                                         Margin="0,-16"
                                                         VerticalAlignment="Top" />
                                    <Grid Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   IsTextSelectionEnabled="True"
                                                   Style="{StaticResource CodeStyleTextBlock}"
                                                   Text="{x:Bind ResourceName}" />
                                        <c:ThemedButton Grid.Column="1"
                                                        Glyph="&#xE8C8;"
                                                        Tag="{x:Bind}"
                                                        Tapped="CopyTapped"
                                                        ToolTipService.ToolTip="Copy style name"
                                                        Visibility="{x:Bind ValidStyle}" />
                                    </Grid>
                                    <c:ThemedButton Grid.Column="1"
                                                    Content="Themed Button"
                                                    Style="{x:Bind Style}" />
                                    <c:ThemedButton Grid.Column="2"
                                                    xaml:VisualStateExtensions.ForceVisualState="PointerOver"
                                                    Content="Themed Button"
                                                    IsHitTestVisible="False"
                                                    Style="{x:Bind Style}" />
                                    <c:ThemedButton Grid.Column="3"
                                                    xaml:VisualStateExtensions.ForceVisualState="Pressed"
                                                    Content="Themed Button"
                                                    IsHitTestVisible="False"
                                                    Style="{x:Bind Style}" />
                                    <c:ThemedButton Grid.Column="4"
                                                    xaml:VisualStateExtensions.ForceVisualState="Disabled"
                                                    Content="Themed Button"
                                                    IsHitTestVisible="False"
                                                    Style="{x:Bind Style}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <InfoBar x:Name="InfoBar"
                 Margin="24"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                 IsOpen="False"
                 Severity="Informational" />
    </Grid>
</c:ObservablePage>