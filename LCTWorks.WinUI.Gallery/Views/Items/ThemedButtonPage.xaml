<c:ObservablePage x:Class="LCTWorks.Workshop.Views.Items.ThemedButtonPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:c="using:LCTWorks.WinUI.Controls"
                  xmlns:clocal="using:LCTWorks.Workshop.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:LCTWorks.Workshop.Views.Items"
                  xmlns:m="using:LCTWorks.Workshop.Models"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                  mc:Ignorable="d">
    <c:ObservablePage.Resources />

    <Grid>
        <ScrollViewer>
            <StackPanel Orientation="Vertical">
                <clocal:SampleCodePresenter x:Name="Sample1Control"
                                            MaxHeight="480"
                                            Margin="16"
                                            HorizontalContentAlignment="Stretch"
                                            Description="{x:Bind Description}"
                                            ExpanderHeader="Code here"
                                            Header="{x:Bind Header}"
                                            MarkdownFilePath="ms-appx:///Assets/CodeSnippets/ThemedButton_Md.txt"
                                            MinOptionsPaneWidth="200">
                    <clocal:SampleCodePresenter.Content>
                        <Grid />
                    </clocal:SampleCodePresenter.Content>
                    <clocal:SampleCodePresenter.OptionsPaneContent>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                        </Grid>
                    </clocal:SampleCodePresenter.OptionsPaneContent>
                </clocal:SampleCodePresenter>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</c:ObservablePage>