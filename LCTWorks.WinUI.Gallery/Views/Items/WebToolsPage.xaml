<c:ObservablePage x:Class="LCTWorks.Workshop.Views.Items.WebToolsPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:c="using:LCTWorks.WinUI.Controls"
                  xmlns:clocal="using:LCTWorks.Workshop.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:LCTWorks.Workshop.Views.Items"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="using:LCTWorks.Workshop.Models"
                  mc:Ignorable="d">

    <c:ObservablePage.Resources>
        <DataTemplate x:Key="PropertyRowTemplate"
                      x:DataType="models:PropertyRow">
            <Grid Padding="0,4"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextSelectionEnabled="True"
                           Text="{x:Bind Name}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1"
                           IsTextSelectionEnabled="True"
                           Text="{x:Bind Value}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HtmlImageTemplate"
                      x:DataType="models:ImageItem">
            <Grid Width="160"
                  Height="160"
                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                  CornerRadius="4"
                  ToolTipService.ToolTip="{x:Bind Src}">
                <c:AdaptiveImage Margin="4"
                                 Source="{x:Bind Src}"
                                 Stretch="Uniform" />
                <Border Padding="6,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource SmokeFillColorDefaultBrush}"
                        CornerRadius="0,4,0,4">
                    <TextBlock FontSize="11"
                               Foreground="White"
                               Text="{x:Bind SizeText}" />
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SampleLinkTemplate"
                      x:DataType="models:SampleLink">
            <Button Padding="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{x:Bind Name}"
                    Click="SampleLinkClick"
                    Tag="{x:Bind Url}"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                <StackPanel Orientation="Vertical">
                    <c:AdaptiveImage Width="24"
                                     Height="24"
                                     HorizontalAlignment="Center"
                                     Source="{x:Bind Icon}" />
                    <TextBlock MaxWidth="82"
                               HorizontalAlignment="Center"
                               MaxLines="1"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{x:Bind Name}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </c:ObservablePage.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel Orientation="Vertical"
                        Spacing="32">
                <clocal:SampleCodePresenter x:Name="Sample"
                                            Margin="16"
                                            HorizontalContentAlignment="Stretch"
                                            CSharpCodeFilePath="ms-appx:///Assets/CodeSnippets/WebTools_Cs.txt"
                                            Description="{x:Bind Description}"
                                            ExpanderHeader="Code"
                                            Header="{x:Bind Header}"
                                            MarkdownFilePath="ms-appx:///Assets/CodeSnippets/WebTools_Md.txt"
                                            MarkdownTabHeader="Documentation"
                                            MinOptionsPaneWidth="420"
                                            ShowThemeSwitch="False">
                    <clocal:SampleCodePresenter.Content>
                        <StackPanel Padding="16"
                                    Orientation="Vertical"
                                    Spacing="16">

                            <!--  Empty state  -->
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Enter a URL in the options pane (or pick a sample) to generate a preview."
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind local:WebToolsPage.IsNull(Card), Mode=OneWay}" />

                            <!--  Link card  -->
                            <Border MaxWidth="640"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{x:Bind local:WebToolsPage.IsNotNull(Card), Mode=OneWay, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Vertical">
                                    <Grid MaxHeight="336"
                                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          CornerRadius="8,8,0,0"
                                          Visibility="{x:Bind local:WebToolsPage.HasText(Card.ImageUrl), Mode=OneWay, FallbackValue=Collapsed}">
                                        <c:AdaptiveImage x:Name="PreviewImage"
                                                         Width="640"
                                                         Height="336"
                                                         ImageFailed="PreviewImageFailed"
                                                         Source="{x:Bind Card.ImageUrl, Mode=OneWay, FallbackValue={x:Null}}"
                                                         Stretch="UniformToFill" />
                                        <Border Margin="8"
                                                Padding="8,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                                CornerRadius="4"
                                                Visibility="{x:Bind local:WebToolsPage.IsTrue(Card.IsNsfw), Mode=OneWay, FallbackValue=Collapsed}">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       Text="NSFW" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Padding="16"
                                                Orientation="Vertical"
                                                Spacing="6">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <c:AdaptiveImage Width="20"
                                                             Height="20"
                                                             VerticalAlignment="Center"
                                                             Source="{x:Bind Card.IconUrl, Mode=OneWay, FallbackValue={x:Null}}"
                                                             Visibility="{x:Bind local:WebToolsPage.HasText(Card.IconUrl), Mode=OneWay, FallbackValue=Collapsed}" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Text="{x:Bind Card.SiteName, Mode=OneWay, FallbackValue=''}" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Text="{x:Bind Card.Author, Mode=OneWay, FallbackValue=''}" />
                                        </StackPanel>
                                        <TextBlock IsTextSelectionEnabled="True"
                                                   MaxLines="2"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   Text="{x:Bind Card.Title, Mode=OneWay, FallbackValue=''}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   IsTextSelectionEnabled="True"
                                                   MaxLines="3"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Text="{x:Bind Card.Description, Mode=OneWay, FallbackValue=''}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                        <HyperlinkButton Margin="-12,0,0,0"
                                                         Click="OpenFinalUrlClick"
                                                         Content="{x:Bind Card.LinkText, Mode=OneWay, FallbackValue=''}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <InfoBar Title="Blocked"
                                     MaxWidth="640"
                                     IsClosable="False"
                                     IsOpen="{x:Bind Card.IsBlocked, Mode=OneWay, FallbackValue=False}"
                                     Message="{x:Bind Card.BlockReason, Mode=OneWay, FallbackValue=''}"
                                     Severity="Warning" />

                            <InfoBar Title="Error"
                                     MaxWidth="640"
                                     IsClosable="True"
                                     IsOpen="{x:Bind local:WebToolsPage.HasTextBool(ErrorText), Mode=OneWay}"
                                     Message="{x:Bind ErrorText, Mode=OneWay}"
                                     Severity="Error" />

                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextSelectionEnabled="True"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind StatusText, Mode=OneWay}"
                                       TextWrapping="Wrap" />

                            <Button HorizontalAlignment="Center"
                                    Click="SeeReportClick"
                                    IsEnabled="{x:Bind local:WebToolsPage.IsNotNullBool(Card), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon FontSize="14"
                                              Glyph="&#xE9F9;" />
                                    <TextBlock Text="See report" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </clocal:SampleCodePresenter.Content>

                    <clocal:SampleCodePresenter.OptionsPaneContent>
                        <ScrollViewer Width="420"
                                      Padding="0,0,16,0">
                            <StackPanel Orientation="Vertical"
                                        Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UrlTextBox"
                                             Header="URL"
                                             KeyDown="UrlTextBoxKeyDown"
                                             PlaceholderText="https://example.com (press Enter)"
                                             Text="{x:Bind UriSourceString, Mode=TwoWay}" />
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Click="PreviewButtonClick"
                                            Content="Preview"
                                            Style="{StaticResource AccentButtonStyle}" />
                                </Grid>

                                <ToggleSwitch Header="Cache"
                                              IsOn="{x:Bind BypassCache, Mode=TwoWay}"
                                              OffContent="Bypass cache"
                                              OnContent="Bypass cache" />
                                <ToggleSwitch Header="Blocked pages"
                                              IsOn="{x:Bind RetryAsPreviewBot, Mode=TwoWay}"
                                              OffContent="Retry as preview bot"
                                              OnContent="Retry as preview bot" />
                                <ToggleSwitch Header="Images"
                                              IsOn="{x:Bind ValidateImages, Mode=TwoWay}"
                                              OffContent="Validate images (slower)"
                                              OnContent="Validate images (slower)" />
                                <ToggleSwitch Header="Bot challenges"
                                              IsOn="{x:Bind UseWebViewFallback, Mode=TwoWay}"
                                              OffContent="Load blocked pages in WebView2"
                                              OnContent="Load blocked pages in WebView2" />

                                <Rectangle Style="{StaticResource SmoothHorizontalSeparatorRectangleStyle}" />

                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="Samples" />
                                <ItemsRepeater ItemTemplate="{StaticResource SampleLinkTemplate}"
                                               ItemsSource="{x:Bind Samples}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout ItemsStretch="Fill"
                                                           MinColumnSpacing="8"
                                                           MinItemHeight="56"
                                                           MinItemWidth="80"
                                                           MinRowSpacing="8" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </ScrollViewer>
                    </clocal:SampleCodePresenter.OptionsPaneContent>
                </clocal:SampleCodePresenter>
            </StackPanel>
        </ScrollViewer>

        <!--  Hidden browser used by WebView2PageFetcher. Must be in the tree to initialize; kept 1x1 and invisible.  -->
        <WebView2 x:Name="FetcherWebView"
                  Width="1"
                  Height="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  AutomationProperties.AccessibilityView="Raw"
                  IsHitTestVisible="False"
                  IsTabStop="False"
                  Opacity="0" />

        <!--  Report  -->
        <ContentDialog x:Name="ReportDialog"
                       Title="Report"
                       CloseButtonText="Close"
                       DefaultButton="Close"
                       SecondaryButtonClick="ReportDialogCopyClick"
                       SecondaryButtonText="Copy as text">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
            </ContentDialog.Resources>
            <Grid Width="880"
                  Height="560"
                  RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Vertical"
                            Spacing="2">
                    <TextBlock IsTextSelectionEnabled="True"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind UriSourceString, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{x:Bind StatusText, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Pivot Grid.Row="1">
                    <PivotItem Header="Preview">
                        <ScrollViewer Padding="0,0,16,0">
                            <StackPanel Orientation="Vertical"
                                        Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="WebPreviewer.GetPreviewAsync" />
                                <ItemsRepeater ItemTemplate="{StaticResource PropertyRowTemplate}"
                                               ItemsSource="{x:Bind PreviewRows}" />
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="Crawler">
                        <ScrollViewer Padding="0,0,16,0">
                            <StackPanel Orientation="Vertical"
                                        Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="WebCrawler.FromUrlAsync + computed fields" />
                                <ItemsRepeater ItemTemplate="{StaticResource PropertyRowTemplate}"
                                               ItemsSource="{x:Bind CrawlerRows}" />
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="{x:Bind MetaHeader, Mode=OneWay}">
                        <ScrollViewer Padding="0,0,16,0">
                            <StackPanel Orientation="Vertical"
                                        Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="WebCrawler.GetMetaTags (non-empty values)" />
                                <ItemsRepeater ItemTemplate="{StaticResource PropertyRowTemplate}"
                                               ItemsSource="{x:Bind MetaRows}" />
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>
                    <PivotItem Header="{x:Bind ImagesHeader, Mode=OneWay}">
                        <ScrollViewer Padding="0,0,16,0">
                            <StackPanel Orientation="Vertical"
                                        Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="WebCrawler.GetAllImagesAsync (sorted by width)" />
                                <ItemsRepeater ItemTemplate="{StaticResource HtmlImageTemplate}"
                                               ItemsSource="{x:Bind Images}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinColumnSpacing="8"
                                                           MinItemHeight="160"
                                                           MinItemWidth="160"
                                                           MinRowSpacing="8" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>
                </Pivot>
            </Grid>
        </ContentDialog>
    </Grid>
</c:ObservablePage>